    "menus": {
      "editor/title": [
        {
          "command": "graphforge.runQuery",
          "when": "resourceLangId == cypher && graphforge.module.query.enabled",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "graphforge.getStarted.showHome",
          "when": "view == graphforge.getStarted",
          "group": "navigation@1"
        },
        {
          "command": "graphforge.getStarted.showQuery",
          "when": "view == graphforge.getStarted",
          "group": "navigation@2"
        },
        {
          "command": "graphforge.getStarted.showVisualize",
          "when": "view == graphforge.getStarted",
          "group": "navigation@3"
        },
        {
          "command": "graphforge.refreshExplorer",
          "when": "view == graphforge.projects",
          "group": "navigation"
        },
        {
          "command": "graphforge.openProject",
          "when": "view == graphforge.projects",
          "group": "navigation"
        },
        {
          "command": "graphforge.showOntology",
          "when": "view == graphforge.ontology",
          "group": "navigation"
        },
        {
          "command": "graphforge.loadOntology",
          "when": "view == graphforge.ontology",
          "group": "navigation"
        },
        {
          "command": "graphforge.createAssertion",
          "when": "view == graphforge.knowledge",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "graphforge",
          "title": "GraphForge",
          "icon": "media/graphforge.svg"
        }
      ],
      "panel": [
        {
          "id": "graphforgeResults",
          "title": "GraphForge Results",
          "icon": "media/graphforge.svg"
        }
      ]
    },
    "views": {
      "graphforge": [
        {
          "type": "webview",
          "id": "graphforge.getStarted",
          "name": "Get Started",
          "icon": "$(rocket)"
        },
        {
          "id": "graphforge.projects",
          "name": "Projects",
          "visibility": "collapsed"
        },
        {
          "id": "graphforge.ontology",
          "name": "Ontology",
          "visibility": "collapsed"
        },
        {
          "id": "graphforge.knowledge",
          "name": "Knowledge",
          "visibility": "collapsed"
        }
      ],
      "graphforgeResults": [
        {
          "type": "webview",
          "id": "graphforge.results",
          "name": "Results",
          "icon": "$(table)"
        }
      ]
    },
    "configuration": {
      "title": "GraphForge",
      "properties": {
        "graphforge.nativeModulePath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to a built @curatelabs/graphforge package (directory containing index.js). Leave empty to resolve from node_modules or sibling monorepo."
        },
        "graphforge.openResultGraphOnQuery": {
          "type": "boolean",
          "default": false,
          "description": "Open the Result Graph webview after a successful Cypher query or analyst verb."
        },
        "graphforge.runtime": {
          "type": "string",
          "enum": [
            "auto",
            "node",
            "python"
          ],
          "enumDescriptions": [
            "Prefer @curatelabs/graphforge, except in a Python-first workspace (pyproject.toml/uv.lock/etc., no package.json) where Python is preferred when usable; falls back to whichever runtime is available.",
            "Require @curatelabs/graphforge. Never falls back to Python, even if detected.",
            "Require the Python graphforge bridge. Never falls back to Node, even if available."
          ],
          "default": "auto",
          "description": "Which engine runtime backs Cypher/verb calls. Node is the global default within \"auto\", except a Python-first workspace prefers Python even when @curatelabs/graphforge is available."
        },
        "graphforge.engineVersion": {
          "type": "string",
          "default": "latest",
          "description": "Which graphforge engine version the Setup wizards install \u2014 npm @curatelabs/graphforge for Node, PyPI graphforge for Python. Use \"latest\" (whatever the registry tags latest, which may be outside `graphforge.qualifiedCore`) or a specific version like \"0.6.0-rc.5\". The version picker in Setup Native/Python Binding recommends the newest qualified version and writes here."
        },
        "graphforge.pythonInterpreterPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to a Python interpreter with `graphforge` installed. Leave empty to auto-detect (VS Code Python extension selection, workspace .venv/venv/env, then python3/python on PATH)."
        },
        "graphforge.modules.dangerouslyAllowWorkspaceJavaScript": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "**DANGEROUS:** Allow explicitly confirmed side-loaded modules to execute a relative `.js` or `.cjs` file from their module folder. Code runs with the permissions of the GraphForge extension. This is a user-level machine setting so a workspace cannot enable it for itself. VS Code Workspace Trust and a per-module warning are still required."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run build:xyg && npm run compile:host && npm run compile:webview",
    "compile:host": "vite build && vite build --mode tests",
    "compile:webview": "vite build --config webview-ui/vite.config.mts",
    "watch": "vite build --watch",
    "watch:webview": "vite build --watch --config webview-ui/vite.config.mts",
    "check": "tsc --noEmit && tsc --noEmit -p webview-ui && tsc --noEmit -p tsconfig.bench.json",
    "lint": "npm run check",
    "test": "npm run compile:host && vscode-test",
    "test:unit": "npm run compile && mocha --ui tdd dist/test/visualizationInstanceRegistry.test.js dist/test/projectDetector.test.js dist/test/environmentReport.test.js dist/test/uuid.test.js dist/test/arrowCodec.test.js dist/test/runtimeSelection.test.js dist/test/errorPresentation.test.js dist/test/projectKind.test.js dist/test/pythonInstallCommand.test.js dist/test/engineVersion.test.js dist/test/versionDiscovery.test.js dist/test/pythonProbe.test.js dist/test/pythonBridge.test.js dist/test/settingsSchema.test.js dist/test/getStartedContent.test.js dist/test/viewContributions.test.js dist/test/quickstartSample.test.js dist/test/projectArtifacts.test.js dist/test/agentContext.test.js dist/test/knowledgeStatus.test.js dist/test/pickerCopy.test.js dist/test/paletteTitles.test.js dist/test/resultTableModel.test.js dist/test/entityMutation.test.js dist/test/resultDocument.test.js dist/test/moduleManifest.test.js dist/test/workspaceScript.test.js dist/test/importData.test.js dist/test/hubClone.test.js dist/test/coreQualification.test.js dist/test/hubPublish.test.js dist/test/xygRuntime.test.js",
    "compile:bench": "vite build --mode bench",
    "bench": "npm run compile:bench && npm run bench:run",
    "bench:run": "node dist/bench/index.mjs",
    "verify:package": "node scripts/verify-package-contents.mjs",
    "qualify:hub-clone": "node scripts/qualify-hub-clone.cjs",
    "qualify:hub-clone:dev-container": "node scripts/qualify-hub-clone-remote.cjs",
    "package": "node scripts/package-extension.mjs",
    "build:xyg": "node scripts/build-xyg.mjs"
  },
  "dependencies": {
    "apache-arrow": "^21.2.0",
    "semver": "^7.8.5",
    "koffi": "3.1.4"
  },
  "peerDependencies": {
