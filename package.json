{
  "name": "graphforge",
  "displayName": "GraphForge",
  "description": "Explore GraphForge projects in VS Code — Cypher, analyst verbs, ontology, and epistemic-aware result graphs.",
  "version": "0.1.0",
  "publisher": "CurateLabs",
  "icon": "media/icon.png",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=20"
  },
  "categories": [
    "Programming Languages",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "graphforge",
    "cypher",
    "opencypher",
    "graph",
    "knowledge-graph",
    "ontology"
  ],
  "activationEvents": [
    "onLanguage:cypher",
    "workspaceContains:FORMAT"
  ],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/CurateLabs/graphforge-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/CurateLabs/graphforge-vscode/issues"
  },
  "homepage": "https://github.com/CurateLabs/graphforge-vscode#readme",
  "galleryBanner": {
    "color": "#0B1220",
    "theme": "dark"
  },
  "contributes": {
    "languages": [
      {
        "id": "cypher",
        "aliases": [
          "Cypher",
          "openCypher"
        ],
        "extensions": [
          ".cypher",
          ".cql"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cypher",
        "scopeName": "source.cypher",
        "path": "./syntaxes/cypher.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "graphforge.openProject",
        "title": "GraphForge: Open Project",
        "icon": "$(folder-opened)"
      },
      {
        "command": "graphforge.refreshExplorer",
        "title": "GraphForge: Refresh Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "graphforge.runQuery",
        "title": "GraphForge: Run Query",
        "icon": "$(play)"
      },
      {
        "command": "graphforge.runQueryWithParams",
        "title": "GraphForge: Run Query with Parameters…"
      },
      {
        "command": "graphforge.getStarted",
        "title": "GraphForge: Get Started",
        "icon": "$(rocket)"
      },
      {
        "command": "graphforge.chooseExperienceMode",
        "title": "GraphForge: Choose Experience Mode…"
      },
      {
        "command": "graphforge.openSettings",
        "title": "GraphForge: Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "graphforge.checkEnvironment",
        "title": "GraphForge: Check Environment"
      },
      {
        "command": "graphforge.setupNativeBinding",
        "title": "GraphForge: Setup Native Binding"
      },
      {
        "command": "graphforge.setupPythonBinding",
        "title": "GraphForge: Setup Python Binding"
      },
      {
        "command": "graphforge.initializeProjectHere",
        "title": "GraphForge: Initialize Project Here"
      },
      {
        "command": "graphforge.rank",
        "title": "GraphForge: Rank"
      },
      {
        "command": "graphforge.rankAdvanced",
        "title": "GraphForge: Rank (Advanced)…"
      },
      {
        "command": "graphforge.cluster",
        "title": "GraphForge: Cluster"
      },
      {
        "command": "graphforge.clusterAdvanced",
        "title": "GraphForge: Cluster (Advanced)…"
      },
      {
        "command": "graphforge.paths",
        "title": "GraphForge: Paths"
      },
      {
        "command": "graphforge.pathsAdvanced",
        "title": "GraphForge: Paths (Advanced)…"
      },
      {
        "command": "graphforge.analyze",
        "title": "GraphForge: Analyze"
      },
      {
        "command": "graphforge.analyzeAdvanced",
        "title": "GraphForge: Analyze (Advanced)…"
      },
      {
        "command": "graphforge.similar",
        "title": "GraphForge: Similar"
      },
      {
        "command": "graphforge.similarAdvanced",
        "title": "GraphForge: Similar (Advanced)…"
      },
      {
        "command": "graphforge.find",
        "title": "GraphForge: Find"
      },
      {
        "command": "graphforge.indexText",
        "title": "GraphForge: Index Text…"
      },
      {
        "command": "graphforge.indexVector",
        "title": "GraphForge: Index Vector…"
      },
      {
        "command": "graphforge.inspectTextIndex",
        "title": "GraphForge: Inspect Text Index…"
      },
      {
        "command": "graphforge.indexAdjacency",
        "title": "GraphForge: Index Adjacency"
      },
      {
        "command": "graphforge.inspectAdjacency",
        "title": "GraphForge: Inspect Adjacency Index"
      },
      {
        "command": "graphforge.rebuildAdjacency",
        "title": "GraphForge: Rebuild Adjacency Index"
      },
      {
        "command": "graphforge.createCheckpoint",
        "title": "GraphForge: Create Checkpoint…"
      },
      {
        "command": "graphforge.listCheckpoints",
        "title": "GraphForge: List Checkpoints"
      },
      {
        "command": "graphforge.openCheckpoint",
        "title": "GraphForge: Open Checkpoint…"
      },
      {
        "command": "graphforge.diffCheckpoints",
        "title": "GraphForge: Diff Checkpoints…"
      },
      {
        "command": "graphforge.deleteCheckpoint",
        "title": "GraphForge: Delete Checkpoint…"
      },
      {
        "command": "graphforge.revertToCheckpoint",
        "title": "GraphForge: Revert to Checkpoint…"
      },
      {
        "command": "graphforge.embeddingSpaces",
        "title": "GraphForge: Embedding Spaces"
      },
      {
        "command": "graphforge.publishCallerEmbeddings",
        "title": "GraphForge: Publish Caller Embeddings…"
      },
      {
        "command": "graphforge.bindEmbeddingSpaceAlias",
        "title": "GraphForge: Bind Embedding Space Alias…"
      },
      {
        "command": "graphforge.setDefaultEmbeddingSpace",
        "title": "GraphForge: Set Default Embedding Space…"
      },
      {
        "command": "graphforge.deleteEmbeddingSpace",
        "title": "GraphForge: Delete Embedding Space…"
      },
      {
        "command": "graphforge.inspectEmbeddingSpaceFreshness",
        "title": "GraphForge: Inspect Embedding Space Freshness…"
      },
      {
        "command": "graphforge.enableCapability",
        "title": "GraphForge: Enable Capability…"
      },
      {
