    "@curatelabs/graphforge-cli": "^0.6.0-rc.5"
  },
  "peerDependenciesMeta": {
    "@curatelabs/graphforge": {
      "optional": true
    },
    "@curatelabs/graphforge-cli": {
      "optional": true
    }
  },
  "devDependencies": {
