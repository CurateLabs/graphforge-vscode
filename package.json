{
  "name": "graphforge",
  "displayName": "GraphForge",
  "description": "Explore GraphForge projects in VS Code \u2014 Cypher, analyst verbs, ontology, and epistemic-aware result graphs.",
  "version": "0.1.3",
  "publisher": "CurateLabsAI",
  "icon": "media/icon.png",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=20"
  },
  "graphforge": {
    "qualifiedCore": {
      "range": ">=0.6.0-rc.5 <0.7.0",
      "refuseBelow": "0.5.1",
      "note": "GraphForge Core versions (@curatelabs/graphforge on npm, graphforge on PyPI) this extension build was qualified against. In range: qualified. Parseable but outside range: warn with CORE_VERSION_UNQUALIFIED. Below refuseBelow: refuse with CORE_VERSION_UNSUPPORTED. Read by src/session/coreQualification.ts."
    }
  },
  "categories": [
    "Programming Languages",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "graphforge",
    "cypher",
    "opencypher",
    "graph",
    "knowledge-graph",
    "ontology"
  ],
  "activationEvents": [
    "onLanguage:cypher",
    "onUri",
    "workspaceContains:FORMAT",
    "onCommand:graphforge.getStarted.showHub"
  ],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/CurateLabs/graphforge-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/CurateLabs/graphforge-vscode/issues"
  },
  "homepage": "https://github.com/CurateLabs/graphforge-vscode#readme",
  "galleryBanner": {
    "color": "#0B1220",
    "theme": "dark"
  },
  "contributes": {
    "languages": [
      {
        "id": "cypher",
        "aliases": [
          "Cypher",
          "openCypher"
        ],
        "extensions": [
          ".cypher",
          ".cql"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cypher",
        "scopeName": "source.cypher",
        "path": "./syntaxes/cypher.tmLanguage.json"
      }
    ],
