{
  "name": "graphforge",
  "displayName": "GraphForge",
  "description": "Explore GraphForge projects in VS Code — Cypher, analyst verbs, ontology, and epistemic-aware result graphs.",
  "version": "0.1.0",
  "publisher": "CurateLabsAI",
  "icon": "media/icon.png",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=20"
  },
  "categories": [
    "Programming Languages",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "graphforge",
    "cypher",
    "opencypher",
    "graph",
    "knowledge-graph",
    "ontology"
  ],
  "activationEvents": [
    "onLanguage:cypher",
    "workspaceContains:FORMAT"
  ],
  "main": "./dist/extension.js",
