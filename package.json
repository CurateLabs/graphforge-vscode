        "title": "GraphForge: Explain Ontology Mode"
      },
      {
        "command": "graphforge.listAssertions",
        "title": "GraphForge: List Assertions"
      },
      {
        "command": "graphforge.createAssertion",
        "title": "GraphForge: Create Assertion…",
        "icon": "$(add)"
      },
      {
        "command": "graphforge.showAssertion",
        "title": "GraphForge: Show Assertion…"
      },
      {
        "command": "graphforge.showAssertionOnGraph",
        "title": "GraphForge: Show Assertion on Graph…"
      },
      {
        "command": "graphforge.attachEvidence",
        "title": "GraphForge: Attach Evidence… (Advanced)"
      },
      {
        "command": "graphforge.assessConfidence",
        "title": "GraphForge: Assess Confidence… (Advanced)"
      },
      {
        "command": "graphforge.recordAssertionStatus",
        "title": "GraphForge: Record Assertion Status… (Advanced)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "graphforge.runQuery",
          "when": "resourceLangId == cypher",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "graphforge.getStarted",
          "when": "view == graphforge.getStarted",
          "group": "navigation"
        },
        {
          "command": "graphforge.refreshExplorer",
          "when": "view == graphforge.projects",
          "group": "navigation"
        },
        {
          "command": "graphforge.openProject",
          "when": "view == graphforge.projects",
          "group": "navigation"
        },
        {
          "command": "graphforge.showOntology",
          "when": "view == graphforge.ontology",
          "group": "navigation"
        },
        {
          "command": "graphforge.loadOntology",
          "when": "view == graphforge.ontology",
          "group": "navigation"
        },
        {
          "command": "graphforge.createAssertion",
          "when": "view == graphforge.knowledge",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "graphforge",
          "title": "GraphForge",
          "icon": "media/graphforge.svg"
        }
      ]
    },
    "views": {
      "graphforge": [
        {
          "type": "webview",
          "id": "graphforge.getStarted",
          "name": "Get Started",
          "icon": "$(rocket)"
        },
        {
          "id": "graphforge.projects",
          "name": "Projects"
        },
        {
          "id": "graphforge.ontology",
          "name": "Ontology"
        },
        {
          "id": "graphforge.knowledge",
          "name": "Knowledge"
        }
      ]
    },
    "configuration": {
      "title": "GraphForge",
      "properties": {
        "graphforge.nativeModulePath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to a built @graphforge/node package (directory containing index.js). Leave empty to resolve from node_modules or sibling monorepo."
        },
        "graphforge.openResultGraphOnQuery": {
          "type": "boolean",
          "default": true,
          "description": "Open the Result Graph webview after a successful Cypher query or analyst verb."
        },
        "graphforge.runtime": {
          "type": "string",
          "enum": [
            "auto",
            "node",
            "python"
          ],
          "enumDescriptions": [
            "Prefer @graphforge/node, except in a Python-first workspace (pyproject.toml/uv.lock/etc., no package.json) where Python is preferred when usable; falls back to whichever runtime is available.",
            "Require @graphforge/node. Never falls back to Python, even if detected.",
            "Require the Python graphforge bridge. Never falls back to Node, even if available."
          ],
          "default": "auto",
          "description": "Which engine runtime backs Cypher/verb calls. Node is the global default within \"auto\", except a Python-first workspace prefers Python even when @graphforge/node is available."
        },
        "graphforge.pythonInterpreterPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to a Python interpreter with `graphforge` installed. Leave empty to auto-detect (VS Code Python extension selection, workspace .venv/venv/env, then python3/python on PATH)."
        },
        "graphforge.experienceMode": {
          "type": "string",
          "enum": [
            "guided",
            "autonomous"
          ],
          "enumDescriptions": [
            "Confirms before Initialize; quieter auto-run; Result Graph stays closed until opened.",
            "Auto-opens detected projects and the Result Graph after queries; skips routine confirmations. Still fails closed on destructive operations."
          ],
          "default": "guided",
          "description": "How much GraphForge confirms with you vs. acts on its own. Set from the Welcome step in Get Started, or here."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run compile:host && npm run compile:webview",
    "compile:host": "node esbuild.mjs",
    "compile:webview": "vite build --config webview-ui/vite.config.ts",
    "watch": "node esbuild.mjs --watch",
    "watch:webview": "vite build --watch --config webview-ui/vite.config.ts",
    "check": "tsc --noEmit && tsc --noEmit -p webview-ui",
    "lint": "npm run check",
    "test": "vscode-test",
    "test:unit": "npm run compile && mocha --ui tdd dist/test/projectDetector.test.js dist/test/environmentReport.test.js dist/test/uuid.test.js dist/test/arrowCodec.test.js dist/test/runtimeSelection.test.js dist/test/errorPresentation.test.js dist/test/projectKind.test.js dist/test/pythonInstallCommand.test.js dist/test/pythonProbe.test.js dist/test/pythonBridge.test.js dist/test/experienceMode.test.js dist/test/settingsSchema.test.js dist/test/getStartedContent.test.js dist/test/knowledgeStatus.test.js",
    "package": "vsce package"
  },
  "dependencies": {
    "apache-arrow": "^18.0.0"
  },
  "peerDependencies": {
    "@graphforge/node": ">=0.5.0-dev.0"
  },
  "peerDependenciesMeta": {
    "@graphforge/node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.96.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.3.2",
    "esbuild": "^0.25.1",
    "mocha": "^11.1.0",
    "typescript": "^5.8.2",
    "vite": "^7.3.6"
  }
}
