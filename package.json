        "title": "GraphForge: Show Result Graph"
      },
      {
        "command": "graphforge.showResultGraphAdvanced",
        "title": "GraphForge: Result Graph (Advanced)…"
      },
      {
        "command": "graphforge.statusBarClick",
        "title": "GraphForge: Status Bar"
      },
      {
        "command": "graphforge.showCapabilities",
        "title": "GraphForge: Show Project Capabilities"
      },
      {
        "command": "graphforge.loadOntology",
        "title": "GraphForge: Load Ontology…",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "graphforge.openOntologyFile",
        "title": "GraphForge: Open ontology.json"
      },
      {
