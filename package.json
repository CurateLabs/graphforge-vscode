      "activitybar": [
        {
          "id": "graphforge",
          "title": "GraphForge",
          "icon": "media/graphforge.svg"
        }
      ],
      "panel": [
        {
          "id": "graphforgeResults",
          "title": "GraphForge Results",
          "icon": "media/graphforge.svg"
        }
      ]
    },
    "views": {
      "graphforge": [
        {
          "type": "webview",
          "id": "graphforge.getStarted",
          "name": "Get Started",
          "icon": "$(rocket)"
        },
        {
          "id": "graphforge.projects",
          "name": "Projects"
        },
        {
          "id": "graphforge.ontology",
          "name": "Ontology"
        },
        {
          "id": "graphforge.knowledge",
          "name": "Knowledge"
        }
      ],
      "graphforgeResults": [
        {
          "type": "webview",
          "id": "graphforge.results",
          "name": "Results",
          "icon": "$(table)"
        }
      ]
    },
    "configuration": {
      "title": "GraphForge",
      "properties": {
        "graphforge.nativeModulePath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to a built @curatelabs/graphforge package (directory containing index.js). Leave empty to resolve from node_modules or sibling monorepo."
        },
        "graphforge.openResultGraphOnQuery": {
          "type": "boolean",
          "default": true,
          "description": "Open the Result Graph webview after a successful Cypher query or analyst verb."
        },
        "graphforge.resultGraph.renderer": {
          "type": "string",
          "enum": [
            "cytoscape",
            "sigma"
          ],
          "enumDescriptions": [
            "Canvas-based default with force layout, pan, zoom, fit, and selection.",
            "WebGL renderer optimized for larger result graphs, with ForceAtlas2 layout and selection."
          ],
          "default": "cytoscape",
          "description": "Renderer used by the Result Graph. Changes apply immediately to an open panel."
        },
        "graphforge.runtime": {
          "type": "string",
          "enum": [
            "auto",
            "node",
            "python"
          ],
          "enumDescriptions": [
            "Prefer @curatelabs/graphforge, except in a Python-first workspace (pyproject.toml/uv.lock/etc., no package.json) where Python is preferred when usable; falls back to whichever runtime is available.",
            "Require @curatelabs/graphforge. Never falls back to Python, even if detected.",
            "Require the Python graphforge bridge. Never falls back to Node, even if available."
          ],
          "default": "auto",
          "description": "Which engine runtime backs Cypher/verb calls. Node is the global default within \"auto\", except a Python-first workspace prefers Python even when @curatelabs/graphforge is available."
        },
        "graphforge.engineVersion": {
          "type": "string",
          "default": "latest",
          "description": "Which graphforge engine version the Setup wizards install — npm @curatelabs/graphforge for Node, PyPI graphforge for Python. Use \"latest\" or a specific version like \"0.5.1\". The version picker in Setup Native/Python Binding writes here."
        },
        "graphforge.pythonInterpreterPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to a Python interpreter with `graphforge` installed. Leave empty to auto-detect (VS Code Python extension selection, workspace .venv/venv/env, then python3/python on PATH)."
        },
        "graphforge.experienceMode": {
          "type": "string",
          "enum": [
            "guided",
            "autonomous"
          ],
          "enumDescriptions": [
            "Confirms before Initialize; quieter auto-run; Result Graph stays closed until opened.",
            "Auto-opens detected projects and the Result Graph after queries; skips routine confirmations. Still fails closed on destructive operations."
          ],
          "default": "guided",
          "description": "How much GraphForge confirms with you vs. acts on its own. Set from the Welcome step in Get Started, or here."
        },
        "graphforge.figureLimitsEnabled": {
          "type": "boolean",
          "default": false,
          "description": "When true, reject Plotly figures that exceed figureMaxTraces / figureMaxPoints / figureMaxBytes. Off by default."
        },
        "graphforge.figureMaxTraces": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "Maximum number of Plotly traces when figureLimitsEnabled is true."
        },
        "graphforge.figureMaxPoints": {
          "type": "number",
          "default": 100000,
          "minimum": 1,
          "description": "Approximate maximum x/y points across traces when figureLimitsEnabled is true."
        },
        "graphforge.figureMaxBytes": {
          "type": "number",
          "default": 10000000,
          "minimum": 1,
          "description": "Maximum serialized figure JSON size in bytes when figureLimitsEnabled is true."
        },
        "graphforge.modules.dangerouslyAllowWorkspaceJavaScript": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "**DANGEROUS:** Allow explicitly confirmed side-loaded modules to execute a relative `.js` or `.cjs` file from their module folder. Code runs with the permissions of the GraphForge extension. This is a user-level machine setting so a workspace cannot enable it for itself. VS Code Workspace Trust and a per-module warning are still required."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run compile:host && npm run compile:webview",
    "compile:host": "vite build && vite build --mode tests",
    "compile:webview": "vite build --config webview-ui/vite.config.mts",
    "watch": "vite build --watch",
    "watch:webview": "vite build --watch --config webview-ui/vite.config.mts",
    "check": "tsc --noEmit && tsc --noEmit -p webview-ui",
    "lint": "npm run check",
    "test": "npm run compile:host && vscode-test",
    "test:unit": "npm run compile && mocha --ui tdd dist/test/projectDetector.test.js dist/test/environmentReport.test.js dist/test/uuid.test.js dist/test/arrowCodec.test.js dist/test/runtimeSelection.test.js dist/test/errorPresentation.test.js dist/test/projectKind.test.js dist/test/pythonInstallCommand.test.js dist/test/engineVersion.test.js dist/test/versionDiscovery.test.js dist/test/pythonProbe.test.js dist/test/pythonBridge.test.js dist/test/experienceMode.test.js dist/test/settingsSchema.test.js dist/test/getStartedContent.test.js dist/test/quickstartSample.test.js dist/test/projectArtifacts.test.js dist/test/agentContext.test.js dist/test/knowledgeStatus.test.js dist/test/pickerCopy.test.js dist/test/paletteTitles.test.js dist/test/figureFromResult.test.js dist/test/figureSchema.test.js dist/test/resultGraphModel.test.js dist/test/resultTableModel.test.js dist/test/entityMutation.test.js dist/test/resultDocument.test.js dist/test/moduleManifest.test.js dist/test/workspaceScript.test.js dist/test/importData.test.js",
    "package": "vsce package"
  },
