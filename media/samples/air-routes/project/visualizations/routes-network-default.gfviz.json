{
  "format": "graphforge.visualization/v2",
  "name": "US routes network — Cytoscape",
  "kind": "result-graph",
  "result": "results/query-result.json",
  "filters": [],
  "renderer": { "id": "cytoscape", "backend": "canvas" },
  "graph": {
    "layout": {
      "type": "cose",
      "execution": "main",
      "animation": false,
    "maxIterations": 250,
      "gravity": 0.7,
      "nodeRepulsion": 180000,
      "idealEdgeLength": 42
    },
    "style": {
      "preset": "graphforge-epistemic/v1",
      "nodeLabelFields": ["name", "label"],
      "nodeLabelFallback": "label-or-id",
      "edgeLabelField": "type",
      "showEdgeLabels": false,
      "nodeSize": 22,
      "edgeWidth": 1.3,
      "arrowheads": false
    },
    "interactions": { "pan": true, "zoom": true, "select": true, "fit": true, "relayout": true },
    "timebar": { "enabled": false }
  }
}
